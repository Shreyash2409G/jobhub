# Copy this file to ".env" and change the values. Never put .env on GitHub.

# ---- Database ---------------------------------------------------------------
# MySQL on your computer (create the database first, see README):
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/jobhub
# No MySQL yet? Try the API with a local file database instead:
# DATABASE_URL=sqlite:///jobhub.db
# A hosted MySQL (Railway ...) gives "mysql://user:pass@host:port/db". That also works: the driver name is added for you.

# ---- Secrets (long random text) --------------------------------------------
# Make each one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_EXPIRES_HOURS=8

# ---- Website addresses allowed to call this API (comma separated) ---------------
# On the live site put your Vercel/Netlify address, e.g. https://jobhub.vercel.app
CORS_ORIGINS=http://localhost:4200

# development = your computer (any localhost port is allowed, weak secrets only warn)
# production  = the live site (the server REFUSES to start with weak secrets)
APP_ENV=development

UPLOAD_FOLDER=uploads
